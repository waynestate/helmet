{
    "name": "waynestate/helmet",
    "description": "Wayne State's baseline runtime: security headers, session hardening, trusted proxies, a health check and structured logs for web apps.",
    "homepage": "https://helmet.apps.wayne.edu/",
    "support": {
        "source": "https://github.com/waynestate/helmet"
    },
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Wayne State University, Enterprise Applications"
        }
    ],
    "require": {
        "php": "^8.3",
        "monolog/monolog": "^3.0",
        "paragonie/csp-builder": "^3.1",
        "promphp/prometheus_client_php": "^2.15",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0",
        "psr/http-server-middleware": "^1.0",
        "symfony/http-foundation": "^7.4"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "nyholm/psr7": "^1.8",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "waynestate/pinstripe": "dev-main"
    },
    "suggest": {
        "laravel/framework": "For the Laravel adapter (step 2)"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Waynestate\\Helmet\\Laravel\\HelmetServiceProvider"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "Waynestate\\Helmet\\": "src/"
        },
        "files": [
            "src/functions.php",
            "src/Ribbon/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Waynestate\\Helmet\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test",
        "fix": "pint",
        "analyse": "phpstan analyse --memory-limit=1G",
        "ci": ["@composer validate --strict", "@test", "@lint", "@analyse", "@composer audit"]
    },
    "scripts-descriptions": {
        "ci": "Run every CI check: validate, tests, Pint, PHPStan, audit."
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        },
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
