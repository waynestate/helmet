{
    "name": "waynestate/helmet",
    "description": "Wayne State's baseline runtime: security headers, session hardening, trusted proxies, a health check and structured logs for web apps.",
    "homepage": "https://helmet.apps.wayne.edu/",
    "support": {
        "source": "https://github.com/waynestate/helmet",
        "issues": "https://git.wayne.edu/enterprise-apps/helmet/-/issues"
    },
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Wayne State University, Enterprise Applications"
        }
    ],
    "require": {
        "php": "^8.3",
        "monolog/monolog": "^3.0",
        "paragonie/csp-builder": "^3.1",
        "promphp/prometheus_client_php": "^2.15",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0",
        "psr/http-server-middleware": "^1.0",
        "symfony/http-foundation": "^7.4"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "league/commonmark": "^2.10",
        "nyholm/psr7": "^1.8",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "waynestate/advisor": "^0.1.6",
        "waynestate/pinstripe": "^0.1"
    },
    "suggest": {
        "laravel/framework": "For the Laravel adapter (step 2)",
        "waynestate/advisor": "ADVISOR module: lets your coding agent read helmet_headers and helmet_php_support, read-only.",
        "waynestate/playbook": "WSU's shared values (CAS, Entra, gateway); private, git.wayne.edu"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Waynestate\\Helmet\\Laravel\\HelmetServiceProvider"
            ]
        },
        "proctor": {
            "wayneui.copies": "fail"
        }
    },
    "autoload": {
        "psr-4": {
            "Waynestate\\Helmet\\": "src/"
        },
        "files": [
            "src/functions.php",
            "src/Ribbon/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Waynestate\\Helmet\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test",
        "fix": "pint",
        "analyse": "phpstan analyse --memory-limit=1G",
        "ci": ["@composer validate --strict", "@test", "@lint", "@analyse", "@site:agent-ready-check", "@docs:check", "@composer audit"],
        "docs": "php bin/docs-site.php",
        "docs:check": "php bin/docs-site.php --check",
        "site:agent-ready": "php bin/agent-ready.php",
        "site:agent-ready-check": "php bin/agent-ready.php --check"
    },
    "scripts-descriptions": {
        "ci": "Run every CI check: validate, tests, Pint, PHPStan, agent-ready files, docs site, audit.",
        "docs": "Build the docs site into site/docs/ from docs/ (Squire's shared builder).",
        "docs:check": "Fail when site/docs/ is stale or a docs page has a broken link, block or nav entry.",
        "site:agent-ready": "Rewrite the Markdown twins, llms.txt, llms-full.txt, robots.txt and sitemap.xml in site/ (Squire's agent-ready kit).",
        "site:agent-ready-check": "Fail when the agent-ready files are stale, a page lacks its Markdown link, a prompt drifts from the docs, or the kit was edited here."
    },
    "config": {
        "sort-packages": true,
        "audit": {
            "abandoned": "report"
        },
        "platform": {
            "php": "8.3.0"
        },
        "allow-plugins": {
            "php-http/discovery": false,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
