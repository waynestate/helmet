includes:
    - vendor/waynestate/pinstripe/phpstan/raw.neon

parameters:
    paths:
        - src
    phpVersion:
        min: 80300
        max: 80599
    ignoreErrors:
        # The report route excludes the web group's CSRF middleware under
        # every name the framework has used for it, so it references the
        # retired ValidateCsrfToken and VerifyCsrfToken classes on purpose;
        # they are deprecated on newer Laravel versions.
        -
            identifier: classConstant.deprecatedClass
            path: src/Laravel/CspReportRoute.php
